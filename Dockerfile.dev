FROM node:22-alpine
WORKDIR /workspace
COPY package*.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/ai/package.json ./apps/ai/package.json
RUN npm ci
COPY apps/api ./apps/api
COPY apps/web ./apps/web
EXPOSE 3000 5173
CMD ["npm", "run", "dev:api"]
