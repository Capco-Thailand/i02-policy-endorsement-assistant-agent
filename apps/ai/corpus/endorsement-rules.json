[
  {
    "sourceId": "FAMILY_PROTECTION:BENEFICIARY:v1",
    "ruleId": "FAMILY_PROTECTION:BENEFICIARY",
    "version": 1,
    "productId": "FAMILY_PROTECTION",
    "changeType": "BENEFICIARY",
    "effectiveFrom": "2025-01-01",
    "effectiveTo": "2035-12-31",
    "title": "FAMILY_PROTECTION BENEFICIARY synthetic endorsement guidance",
    "sections": [
      {
        "sectionId": "rule",
        "role": "RULE",
        "text": "A beneficiary change requires named beneficiaries with allocations totaling 100%.",
        "value": {
          "kind": "CHECK",
          "field": "beneficiaries",
          "requirement": "named beneficiaries and allocations total 100%"
        }
      },
      {
        "sectionId": "guidance",
        "role": "GUIDANCE",
        "text": "No supporting document is required in this synthetic prototype.",
        "value": {
          "kind": "NONE"
        }
      }
    ]
  },
  {
    "sourceId": "FAMILY_PROTECTION:ADDRESS:v1",
    "ruleId": "FAMILY_PROTECTION:ADDRESS",
    "version": 1,
    "productId": "FAMILY_PROTECTION",
    "changeType": "ADDRESS",
    "effectiveFrom": "2025-01-01",
    "effectiveTo": "2035-12-31",
    "title": "FAMILY_PROTECTION ADDRESS synthetic endorsement guidance",
    "sections": [
      {
        "sectionId": "rule",
        "role": "RULE",
        "text": "An address change requires a complete new mailing address.",
        "value": {
          "kind": "CHECK",
          "field": "address",
          "requirement": "complete new mailing address"
        }
      },
      {
        "sectionId": "guidance",
        "role": "GUIDANCE",
        "text": "Address proof may be supplied for a mock receipt; its contents are not verified.",
        "value": {
          "kind": "DOCUMENT",
          "documentType": "address proof",
          "handling": "mock receipt only"
        }
      }
    ]
  },
  {
    "sourceId": "FAMILY_PROTECTION:PAYMENT_FREQUENCY:v1",
    "ruleId": "FAMILY_PROTECTION:PAYMENT_FREQUENCY",
    "version": 1,
    "productId": "FAMILY_PROTECTION",
    "changeType": "PAYMENT_FREQUENCY",
    "effectiveFrom": "2025-01-01",
    "effectiveTo": "2035-12-31",
    "title": "FAMILY_PROTECTION PAYMENT_FREQUENCY synthetic endorsement guidance",
    "sections": [
      {
        "sectionId": "rule",
        "role": "RULE",
        "text": "Payment frequency may change between monthly and annual billing.",
        "value": {
          "kind": "CHECK",
          "field": "paymentFrequency",
          "allowedValues": ["MONTHLY", "ANNUAL"]
        }
      },
      {
        "sectionId": "guidance",
        "role": "GUIDANCE",
        "text": "No supporting document is required in this synthetic prototype.",
        "value": {
          "kind": "NONE"
        }
      }
    ]
  },
  {
    "sourceId": "FAMILY_PROTECTION:ACCIDENTAL_DEATH_RIDER:v1",
    "ruleId": "FAMILY_PROTECTION:ACCIDENTAL_DEATH_RIDER",
    "version": 1,
    "productId": "FAMILY_PROTECTION",
    "changeType": "ACCIDENTAL_DEATH_RIDER",
    "effectiveFrom": "2025-01-01",
    "effectiveTo": "2035-12-31",
    "title": "FAMILY_PROTECTION ACCIDENTAL_DEATH_RIDER synthetic endorsement guidance",
    "sections": [
      {
        "sectionId": "rule",
        "role": "RULE",
        "text": "Adding an accidental-death rider requires human underwriting follow-up and may require health disclosure outside this prototype; do not collect medical evidence here.",
        "value": {
          "kind": "REFERRAL",
          "reason": "underwriting follow-up"
        }
      },
      {
        "sectionId": "guidance",
        "role": "GUIDANCE",
        "text": "A rider request can receive a mock receipt; it does not satisfy underwriting or verify a document.",
        "value": {
          "kind": "DOCUMENT",
          "documentType": "rider request",
          "handling": "mock receipt only"
        }
      }
    ]
  },
